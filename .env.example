CRUNCHYROLL_EMAIL=deine@email.de
CRUNCHYROLL_PASSWORD=dein_passwort

# Optional: language for titles and descriptions (default: en-US), e.g. de-DE
CRUNCHYROLL_LOCALE=de-DE
# Optional: preferred audio language (default: ja-JP)
CRUNCHYROLL_AUDIO_LOCALE=ja-JP

# Optional: log raw Crunchyroll API responses (contains tokens!)
DEV_MODE=false
